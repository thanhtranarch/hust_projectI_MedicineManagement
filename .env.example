# MediManager configuration
#
# This file is OPTIONAL. With no .env at all the app runs on a local SQLite
# database (data/medimanager.db) and needs no setup.
#
# Copy it to .env and fill in the values below only if you want to use a
# PostgreSQL / Supabase server instead.

# Backend: sqlite | postgres
# Leave empty to auto-detect: postgres when DB_HOST + DB_PASSWORD are set,
# otherwise sqlite.
DB_BACKEND=

# SQLite database file (sqlite backend only)
SQLITE_PATH=data/medimanager.db

# PostgreSQL / Supabase connection (postgres backend only).
# Find these at https://supabase.com/dashboard/project/_/settings/database
DB_HOST=db.your-project-id.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password

# Supabase REST credentials (optional, reserved for future use)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here
